# Used by docker-compose.yml. Copy to .env.docker and fill in.
# Generate secrets with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
APP_URL=http://localhost:4000
DEMO_MODE=false
STORAGE_DRIVER=local
# First admin, created on first boot (remove the password afterwards)
FIRST_ADMIN_EMAIL=
FIRST_ADMIN_PASSWORD=
