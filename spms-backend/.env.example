# ─────────────────────────────────────────────────────────────────────────────
# EduTrack API — copy to .env and fill in. Never commit the real .env.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=4000

# Public URL of the web app (used in password-reset links).
APP_URL=http://localhost:5173
# Origins allowed to call the API with credentials (comma-separated).
# Not needed when the API serves the web app itself (single-service deploy).
CLIENT_ORIGIN=http://localhost:5173
# Serve the built web app (../spms-frontend/dist) from this server.
SERVE_CLIENT=true
# CLIENT_DIST_DIR=/absolute/path/to/spms-frontend/dist

# MongoDB — local (`npm run db:local` starts one for you) or MongoDB Atlas.
MONGODB_URI=mongodb://127.0.0.1:27017/edutrack

# JWT — generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# lax (same site, default) | none (web app on a different site; forces Secure)
COOKIE_SAMESITE=lax
COOKIE_SECURE=false

# Accounts
ALLOW_STUDENT_SIGNUP=true
# Shows the seeded demo accounts on the sign-in page. Keep false in production.
DEMO_MODE=false
TEAM_MAX_MEMBERS=5

# First admin (used once by `npm run create-admin`)
FIRST_ADMIN_NAME=System Admin
FIRST_ADMIN_EMAIL=admin@your-college.edu
FIRST_ADMIN_PASSWORD=

# File storage: cloudinary | s3 | local (default: whichever is configured, else local)
STORAGE_DRIVER=
LOCAL_UPLOAD_DIR=uploads

# Cloudinary — https://console.cloudinary.com (Settings → API Keys)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=edutrack

# AWS S3 or S3-compatible (Cloudflare R2, Backblaze B2, MinIO)
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false

# Email for password resets (optional). Example: smtps://user:pass@smtp.gmail.com:465
SMTP_URL=
MAIL_FROM=EduTrack <no-reply@your-college.edu>

# Rate limiting for login/register/reset endpoints
AUTH_RATE_LIMIT_MAX=20
AUTH_RATE_LIMIT_WINDOW_MIN=15
